.species-tabs{display:flex;gap:15rpx;margin:28rpx 0}.app .species-tab{flex:1;width:0;min-width:0;background:var(--surface);color:var(--muted);border:1rpx solid var(--border);border-radius:18rpx;display:flex;align-items:center;justify-content:center;padding:11rpx 7rpx;font-size:23rpx}.species-tab image{height:57rpx;width:56rpx;margin-right:6rpx}.species-tab.selected{border-color:var(--primary);background:var(--soft);color:var(--primary)}.storybook{border:1rpx solid var(--border);border-radius:29rpx;overflow:hidden;background:var(--surface)}.story-scene{height:490rpx;position:relative;overflow:hidden;background:var(--hero);--leaf:#5d8357;--leaf-bright:#88a96c}.scene-grain{position:absolute;inset:0;opacity:.13;background-image:radial-gradient(var(--primary) 1rpx,transparent 1rpx);background-size:13rpx 13rpx}.scene-sun{position:absolute;right:60rpx;top:50rpx;width:90rpx;height:90rpx;border-radius:50%;background:var(--accent);opacity:.9;animation:sun-breathe 6s ease-in-out infinite}.scene-cloud{position:absolute;left:49%;top:92rpx;width:95rpx;height:19rpx;border-radius:60%;background:var(--surface);opacity:.7;animation:cloud-drift 9s ease-in-out infinite}.scene-caption{position:absolute;left:29rpx;top:26rpx;display:flex;flex-direction:column;font-size:15rpx;letter-spacing:2rpx;color:var(--primary)}.scene-caption text{font-size:28rpx;font-weight:650;letter-spacing:0}.scene-horizon{height:115rpx;position:absolute;bottom:0;left:-4%;right:-4%;background:var(--accent);opacity:.26;border-radius:50% 50% 0 0}.scene-plant{position:absolute;width:190rpx;left:50%;bottom:73rpx;transform:translateX(-50%);height:310rpx}.scene-pot{position:absolute;bottom:0;left:19rpx;width:152rpx;height:112rpx;background:var(--primary);border-radius:6rpx 6rpx 36rpx 36rpx;z-index:5;display:flex;align-items:center;justify-content:center;color:var(--on-primary);font-size:15rpx;letter-spacing:3rpx}.scene-pot>view{position:absolute;top:0;left:-10rpx;right:-10rpx;height:18rpx;border-radius:5rpx;background:var(--primary);box-shadow:0 4rpx 0 rgba(0,0,0,.07)}.scene-pot text{opacity:.7;margin-top:13rpx}.scene-stem{position:absolute;bottom:106rpx;left:92rpx;height:225rpx;width:6rpx;border-radius:9rpx;background:var(--leaf);transform-origin:bottom;transition:height .9s ease;animation:stem-sway 5s ease-in-out infinite}.stage-1 .scene-stem{height:60rpx}.stage-2 .scene-stem{height:135rpx}.stage-3 .scene-stem{height:200rpx}.stage-4 .scene-stem{height:235rpx}.scene-leaf{position:absolute;transform-origin:0 50%;transition:all .7s ease;animation:leaf-breathe 5s ease-in-out infinite}.scene-leaf>view{width:100%;height:100%;background:var(--leaf-bright);border:1rpx solid var(--leaf);border-radius:80% 0 80% 0;position:relative;overflow:hidden}.scene-leaf>view:after{content:"";position:absolute;width:100%;height:1rpx;top:50%;left:0;background:var(--leaf);transform:rotate(-24deg);opacity:.5}.leaf-left{right:2rpx;transform-origin:100% 50%;transform:rotate(24deg)}.leaf-right{left:3rpx;transform:rotate(-24deg)}.leaf-left>view{border-radius:0 80% 0 80%}.kind-leafy .scene-leaf>view{border-radius:70% 40% 70% 45%;background:var(--leaf-bright)}.kind-leafy.stage-4 .scene-stem{height:125rpx}.kind-leafy.stage-4 .scene-leaf{width:80rpx!important;height:52rpx!important;bottom:18rpx!important}.kind-leafy.stage-4 .scene-leaf:nth-child(3n){transform:rotate(-63deg);bottom:41rpx!important}.kind-leafy.stage-4 .scene-leaf:nth-child(4n){transform:rotate(42deg);bottom:7rpx!important}.kind-flower .scene-leaf>view{border-radius:80%;background:var(--leaf)}.scene-seed{position:absolute;bottom:111rpx;left:85rpx;width:22rpx;height:14rpx;border-radius:40% 70% 45% 70%;background:var(--primary);transform:rotate(-25deg);animation:seed-rest 5s ease-in-out infinite}.scene-bloom{height:15rpx;width:15rpx;background:#ddbc69;border-radius:50%;position:absolute;z-index:4;box-shadow:12rpx 0 #e6cf95,-12rpx 0 #e6cf95,0 12rpx #e6cf95,0 -12rpx #e6cf95,8rpx 8rpx #e6cf95,-8rpx -8rpx #e6cf95;animation:bloom-open 1.3s ease both}.kind-flower .scene-bloom{background:#dfb57f;box-shadow:12rpx 0 #cf877e,-12rpx 0 #cf877e,0 12rpx #cf877e,0 -12rpx #cf877e,8rpx 8rpx #cf877e,-8rpx -8rpx #cf877e}.stage-3.kind-flower .scene-bloom{width:14rpx;height:23rpx;border-radius:70%;box-shadow:none;background:#c88e7c}.scene-fruit{width:38rpx;height:40rpx;background:#c9674f;border-radius:48%;position:absolute;z-index:6;box-shadow:inset -6rpx -4rpx rgba(117,54,35,.1);animation:bloom-open 1.3s ease both}.scene-fruit>view{position:absolute;top:-7rpx;left:12rpx;width:15rpx;height:10rpx;background:var(--leaf);border-radius:0 70%;transform:rotate(-20deg)}.scene-roots{position:absolute;left:89rpx;bottom:-15rpx;width:12rpx;height:40rpx;opacity:.45;z-index:1}.scene-roots view{position:absolute;width:1rpx;height:40rpx;background:var(--primary);transform-origin:top}.scene-roots view:nth-child(1){transform:rotate(34deg)}.scene-roots view:nth-child(2){transform:rotate(-25deg);height:45rpx}.scene-roots view:nth-child(3){transform:rotate(-55deg);height:27rpx}.scene-ground-label{font-size:16rpx;letter-spacing:2rpx;position:absolute;bottom:24rpx;left:25rpx;color:var(--primary);opacity:.8}.simulation-label{font-size:14rpx;position:absolute;right:20rpx;bottom:24rpx;color:var(--primary);opacity:.8}.chapter-copy{padding:20rpx 26rpx}.chapter-copy>text{display:block;font-size:26rpx;line-height:1.6;color:var(--ink)}.growth-control{display:flex;align-items:center;justify-content:space-between;margin:27rpx 0 16rpx}.app .play-growth{background:var(--primary);color:var(--on-primary);border-radius:30rpx;padding:17rpx 27rpx;font-size:23rpx}.app .motion-toggle{min-height:72rpx;font-size:24rpx;color:var(--muted);padding:12rpx 0}.growth-page slider{margin:15rpx 12rpx 5rpx}.chapter-tabs{display:flex;justify-content:space-between;margin:10rpx 0 30rpx}.chapter-tabs button{width:20%;display:flex;flex-direction:column;align-items:center;color:var(--muted);font-size:19rpx;padding:7rpx 0}.chapter-dot{width:8rpx;height:8rpx;background:var(--border);border-radius:50%;margin-bottom:10rpx}.chapter-tabs .active{color:var(--primary);font-weight:600}.chapter-tabs .active .chapter-dot{background:var(--primary)}.observation-card{padding:27rpx;background:var(--soft);border-radius:23rpx;margin:29rpx 0}.observation-card .card-title{font-size:27rpx;margin:12rpx 0 15rpx}.my-land-story{background:var(--surface);border:1rpx solid var(--border);border-radius:24rpx;padding:30rpx}.story-brand{font-size:15rpx;color:var(--primary);letter-spacing:2rpx}.personal-story-title{font-size:31rpx;line-height:1.75;margin:24rpx 0 14rpx}.personal-story-sub{font-size:20rpx;color:var(--muted);line-height:1.9}.story-quote{font-size:25rpx;line-height:1.9;padding:27rpx 0;white-space:pre-wrap;word-break:break-all}.story-evidence{display:flex;justify-content:space-between;font-size:19rpx;color:var(--muted);border-top:1rpx solid var(--border);padding-top:20rpx;margin-bottom:25rpx}.future-letter{padding:30rpx 8rpx;margin-top:30rpx}.future-letter>text:first-child{font-size:24rpx;color:var(--primary);font-weight:500}.future-letter>view{font-size:22rpx;color:var(--muted);line-height:1.95;margin:18rpx 0}.future-state{font-size:18rpx;color:var(--muted)}.growth-entry{background:var(--hero);border:1rpx solid var(--border);border-radius:24rpx;padding:29rpx;margin:28rpx 0;position:relative;overflow:hidden}.growth-entry .eyebrow{color:var(--primary)}.growth-entry-title{font-size:32rpx;font-weight:500;line-height:1.7;margin:14rpx 0}.growth-entry-copy{font-size:21rpx;line-height:1.85;color:var(--muted);max-width:80%}.growth-entry>button{margin-top:22rpx;color:var(--primary);font-size:23rpx;text-align:left}.growth-entry-stages{display:flex;align-items:center;margin-top:23rpx;color:var(--primary);font-size:20rpx}.growth-entry-stages>text{padding:8rpx 13rpx;border:1rpx solid var(--border);background:var(--surface);border-radius:10rpx}.growth-entry-stages>view{width:24rpx;height:1rpx;background:var(--primary);opacity:.4}.storybook.still .scene-sun,.storybook.still .scene-cloud,.storybook.still .scene-stem,.storybook.still .scene-leaf,.storybook.still .scene-seed,.storybook.still .scene-bloom,.storybook.still .scene-fruit{animation:none!important;transition:none!important}@keyframes sun-breathe{0%,100%{transform:scale(1);opacity:.65}50%{transform:scale(1.07);opacity:.95}}@keyframes cloud-drift{0%,100%{transform:translateX(-15rpx)}50%{transform:translateX(15rpx)}}@keyframes stem-sway{0%,100%{transform:rotate(-2deg)}50%{transform:rotate(2deg)}}@keyframes leaf-breathe{0%,100%{opacity:.82}50%{opacity:1}}@keyframes seed-rest{0%,100%{opacity:.7}50%{opacity:1}}@keyframes bloom-open{from{opacity:0;transform:scale(.3)}to{opacity:1;transform:scale(1)}}

.scene-cutting{position:absolute;bottom:107rpx;left:93rpx;width:4rpx;height:40rpx;background:var(--leaf)}.scene-cutting view{position:absolute;top:1rpx;width:32rpx;height:24rpx;background:var(--leaf-bright);border-radius:70%;left:0;transform:rotate(-24deg)}.scene-cutting view:last-child{left:-29rpx;top:12rpx;transform:rotate(25deg)}.app .chapter-tabs button{flex:1;width:0;min-height:72rpx;font-size:23rpx;justify-content:center}
