.featured .plant-name{font-size:43rpx}
.featured .plant-tag{font-size:25rpx}
.featured .plant-arrow{font-size:25rpx;margin-top:19rpx}
.featured .plant-image{width:220rpx;height:205rpx;margin-right:-4rpx}
.season-note{font-size:27rpx;line-height:1.7;padding:27rpx;margin:27rpx 0 31rpx;border:1rpx solid var(--border)}
.note-label{font-size:28rpx;font-weight:700}
.shortcut-row button{font-size:29rpx;font-weight:600;padding:28rpx 25rpx}
.shortcut-icon{font-size:44rpx}
.shortcut-desc{font-size:23rpx;font-weight:400}
.home-ending{font-size:26rpx}
.home-ending text{font-size:21rpx}

/* Reading pages and forms share the same comfortable scale. */
.page-heading{font-size:46rpx;line-height:1.43;font-weight:700;letter-spacing:0}
.body-copy{font-size:29rpx;line-height:1.75}
.small{font-size:24rpx}
.card{padding:32rpx;border-radius:27rpx;box-shadow:0 8rpx 23rpx rgba(36,48,29,.035)}
.card-title{font-size:34rpx;font-weight:700;line-height:1.4}
.search input,.field{font-size:29rpx}
.tabs{border-bottom:0;margin-bottom:20rpx}
.tab{font-size:28rpx;border:1rpx solid var(--border);border-radius:36rpx;background:var(--surface);margin-right:14rpx;padding:15rpx 26rpx;line-height:1.35}
.tab.active{background:var(--primary);color:var(--on-primary);border-color:var(--primary);box-shadow:0 7rpx 17rpx rgba(38,42,29,.13)}
.filter-caption{font-size:24rpx;gap:8rpx 18rpx;flex-wrap:wrap}
.filter-caption text{font-size:22rpx}
.catalog-card-bottom{font-size:31rpx;font-weight:600}
.catalog-card>.plant-tag{font-size:23rpx}
.plant-big-title{font-size:55rpx;font-weight:700}
.plant-summary{font-size:29rpx;line-height:1.8}
.stat-label{font-size:23rpx}
.stat-value{font-size:28rpx;font-weight:600}
.detail-row,.field-label,.pill,.menu-row{font-size:28rpx}
.step-title,.note-content,
.footnote,.field-help{font-size:23rpx;line-height:1.7}
.primary,.secondary{font-size:29rpx;font-weight:700}
.garden-name,.profile-greeting{font-size:40rpx;font-weight:700}
.garden-card-footer,.progress-label,.note-date{font-size:23rpx}
.profile-tools .profile-tool>view text:first-child{font-size:25rpx;font-weight:600}
.profile-tools .profile-tool>view text:last-child{font-size:20rpx}
.book{font-size:24rpx}
.term-grid button>view{font-size:32rpx;font-weight:600}
.sheet-title{font-size:37rpx;font-weight:700}
.choice-grid .pill{font-size:27rpx}
.weather-stage-copy text:last-child{font-size:25rpx}

/* A small garden grows in the bottom navigation when a tab is selected. */
.tabbar{padding:14rpx 17rpx calc(14rpx + env(safe-area-inset-bottom));border-radius:28rpx 28rpx 0 0;box-shadow:0 -13rpx 33rpx rgba(29,41,25,.08)}
.app .tabbar .tab-item{min-height:101rpx;justify-content:center;font-size:24rpx;color:var(--muted);line-height:1.3}
.tab-icon-wrap{width:66rpx;height:59rpx;border-radius:21rpx;display:flex;align-items:center;justify-content:center;position:relative;transition:transform .3s cubic-bezier(.2,1.4,.4,1),background .25s ease}
.tab-glyph{font-size:47rpx;height:auto;line-height:1;margin:0;transition:transform .3s cubic-bezier(.2,1.4,.4,1)}
.tab-label{font-size:24rpx;margin-top:5rpx;white-space:nowrap;transition:transform .25s ease}
.tab-spark{position:absolute;width:8rpx;height:8rpx;border-radius:9rpx;background:var(--accent);right:7rpx;top:5rpx;opacity:0;transform:scale(.2)}
.tab-item.current{color:var(--primary)}
.tab-item.current .tab-icon-wrap{background:var(--soft);transform:translateY(-7rpx);animation:tab-grow .36s cubic-bezier(.2,1.4,.4,1) both}
.tab-item.current .tab-glyph{transform:scale(1.13)}
.tab-item.current .tab-label{transform:translateY(-4rpx);font-weight:700}
.tab-item.current .tab-spark{opacity:1;transform:scale(1);animation:spark-appear .42s ease-out both}
.app .tabbar .tab-plus{flex:0 0 90rpx;width:90rpx;max-width:90rpx;height:90rpx;margin:0 12rpx;transform:translateY(-12rpx);box-shadow:0 12rpx 24rpx rgba(52,48,29,.22);position:relative;overflow:visible;font-size:59rpx;line-height:82rpx;z-index:1}
.tab-plus>text{position:relative;z-index:2;display:block;transition:transform .3s ease}
.tab-plus.open>text{transform:rotate(45deg)}
.plus-halo{position:absolute;inset:-8rpx;border:2rpx solid var(--primary);border-radius:50%;opacity:.35;animation:halo-breathe 3.3s ease-in-out infinite}
.plus-seed{position:absolute;width:9rpx;height:9rpx;border-radius:50%;background:var(--accent);opacity:0}
.seed-one{top:-12rpx;left:15rpx}.seed-two{top:4rpx;right:-11rpx}.seed-three{bottom:7rpx;left:-12rpx}
.tab-plus.open .plus-seed{animation:seed-burst .35s ease-out both}
.tab-plus.open .seed-two{animation-delay:.06s}.tab-plus.open .seed-three{animation-delay:.12s}
@keyframes tab-grow{0%{transform:translateY(4rpx) scale(.85)}65%{transform:translateY(-10rpx) scale(1.06)}100%{transform:translateY(-7rpx) scale(1)}}
@keyframes spark-appear{0%{opacity:0;transform:translateY(8rpx) scale(.2)}100%{opacity:1;transform:translateY(0) scale(1)}}
@keyframes halo-breathe{0%,100%{transform:scale(.97);opacity:.25}50%{transform:scale(1.07);opacity:.48}}
@keyframes seed-burst{0%{opacity:0;transform:scale(.2)}60%{opacity:1;transform:scale(1.2)}100%{opacity:.8;transform:scale(1)}}

/* Quiet continuous motion keeps the garden navigation alive. */
.tab-item .tab-glyph{display:block;animation:tab-idle 4.8s ease-in-out infinite;transform-origin:center 80%}
.tab-item:nth-child(2) .tab-glyph{animation-delay:-1.2s}
.tab-item:nth-child(4) .tab-glyph{animation-delay:-2.4s}
.tab-item:nth-child(5) .tab-glyph{animation-delay:-3.6s}
.tab-item.current .tab-glyph{animation:tab-alive 2.8s ease-in-out infinite}
.tab-item.current .tab-spark{animation:spark-breathe 2.8s ease-in-out infinite}
.tab-plus:not(.open)>text{animation:plus-float 3.3s ease-in-out infinite}
@keyframes tab-idle{0%,78%,100%{transform:translateY(0) rotate(0)}86%{transform:translateY(-4rpx) rotate(-5deg)}93%{transform:translateY(-2rpx) rotate(3deg)}}
@keyframes tab-alive{0%,100%{transform:translateY(0) rotate(-4deg) scale(1.07)}50%{transform:translateY(-5rpx) rotate(4deg) scale(1.14)}}
@keyframes spark-breathe{0%,100%{opacity:.38;transform:scale(.7)}50%{opacity:1;transform:scale(1.25)}}
@keyframes plus-float{0%,100%{transform:translateY(0)}50%{transform:translateY(-4rpx)}}

/* Native date and list pickers become a consistent, touch-friendly garden sheet. */
.app .custom-picker{display:flex;align-items:center;justify-content:space-between;padding:0 25rpx;text-align:left;border-radius:20rpx;font-weight:600;box-shadow:0 6rpx 17rpx rgba(36,48,29,.035)}
.custom-picker>text{color:var(--primary);font-size:34rpx}
.sheet-mask{animation:mask-in .2s ease both}
.sheet{animation:sheet-up .34s cubic-bezier(.2,.8,.2,1) both;box-shadow:0 -16rpx 44rpx rgba(20,31,17,.15)}
.custom-options{max-height:48vh;overflow-y:auto}
.custom-option{width:100%;display:flex;justify-content:space-between;align-items:center;padding:26rpx 13rpx;border-bottom:1rpx solid var(--border);font-size:29rpx;text-align:left;color:var(--ink)}
.custom-option.selected,.month-option.selected{color:var(--primary);font-weight:700}
.month-options{display:flex;flex-wrap:wrap;gap:14rpx}
.month-option{width:30.7%;padding:22rpx 8rpx;text-align:center;border-radius:18rpx;border:1rpx solid var(--border);background:var(--bg);color:var(--ink);font-size:28rpx}
.month-option.selected{background:var(--soft);border-color:var(--primary)}
.date-preview{font-size:39rpx;font-weight:700;color:var(--primary);text-align:center;padding:12rpx 0 28rpx}
.date-columns{display:flex;gap:12rpx}
.date-column{flex:1;min-width:0;text-align:center}
.date-column-title{display:block;font-size:23rpx;color:var(--muted);margin-bottom:13rpx}
.date-scroll{height:330rpx;border-radius:18rpx;background:var(--bg);border:1rpx solid var(--border)}
.date-cell{width:100%;height:72rpx;line-height:72rpx;font-size:27rpx;color:var(--ink);border-radius:14rpx}
.date-cell.selected{background:var(--primary);color:var(--on-primary);font-weight:700}
.discard-copy{font-size:28rpx;line-height:1.7;color:var(--muted);padding:4rpx 0 11rpx}
.discard-actions{display:flex;gap:15rpx;margin-top:25rpx}
.discard-actions button{flex:1;min-width:0}
@keyframes mask-in{from{opacity:0}to{opacity:1}}
@keyframes sheet-up{from{transform:translateY(45rpx);opacity:.7}to{transform:translateY(0);opacity:1}}

/* Balanced custom navigation with one icon language. */
.navigation{display:flex;align-items:center;gap:17rpx;padding:0 31rpx}
.app .navigation .nav-back{flex:0 0 60rpx;width:60rpx;max-width:60rpx;min-width:60rpx;height:60rpx;padding:0;margin:0;display:flex;align-items:center;justify-content:center;background:var(--surface);border:1rpx solid var(--border);border-radius:19rpx;box-shadow:0 4rpx 11rpx rgba(40,54,36,.045)}
.nav-back image{width:33rpx;height:33rpx;display:block}
.navigation .brand-mark{flex:0 0 60rpx;width:60rpx;height:60rpx;margin:0;box-sizing:border-box;display:flex;align-items:center;justify-content:center;line-height:1;font-size:30rpx;border-radius:19rpx}
.navigation .nav-title{display:block;min-width:0;max-width:calc(100% - 250rpx);font-size:34rpx;line-height:1.2;font-weight:700;letter-spacing:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.navigation button::after,.tabbar button::after{border:0}

.tabbar{display:flex;align-items:stretch;justify-content:space-between;gap:0;padding:8rpx 15rpx calc(9rpx + env(safe-area-inset-bottom));border-radius:23rpx 23rpx 0 0;box-shadow:0 -8rpx 28rpx rgba(27,42,30,.075)}
.app .tabbar .tab-item,.app .tabbar .tab-add{flex:1 1 20%;width:20%;min-width:0;min-height:106rpx;margin:0;padding:8rpx 0 2rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6rpx;color:var(--muted);background:transparent;border:0;border-radius:0;line-height:1}
.tabbar .tab-icon-wrap{width:60rpx;height:60rpx;display:flex;align-items:center;justify-content:center;border-radius:20rpx;background:transparent;transform:none;animation:none}
.tabbar .tab-icon{width:44rpx;height:44rpx;display:block;opacity:.59}
.tabbar .tab-label{font-size:22rpx;font-weight:500;line-height:1.25;margin:0;transform:none}
.tabbar .tab-item.current .tab-icon-wrap{background:var(--soft);transform:none;animation:none}
.tabbar .tab-item.current .tab-icon{opacity:1;animation:nav-icon-breathe 3.8s ease-in-out infinite}
.tabbar .tab-item.current .tab-label{color:var(--primary);font-weight:700;transform:none}
.tabbar .tab-add-mark{width:60rpx;height:60rpx;border-radius:21rpx;display:flex;align-items:center;justify-content:center;color:var(--on-primary);background:var(--primary);box-shadow:0 6rpx 14rpx rgba(58,62,44,.14);animation:nav-add-breathe 3.8s ease-in-out infinite}
.tabbar .tab-add-mark text{font-size:42rpx;line-height:1;font-weight:400;transition:transform .25s ease}
.tabbar .tab-add.open .tab-add-mark text{transform:rotate(45deg)}
.tabbar .tab-add .tab-label{color:var(--primary);font-weight:700}
@keyframes nav-icon-breathe{0%,100%{transform:translateY(0) scale(1)}50%{transform:translateY(-2rpx) scale(1.055)}}
@keyframes nav-add-breathe{0%,100%{transform:scale(1);box-shadow:0 6rpx 14rpx rgba(58,62,44,.14)}50%{transform:scale(1.055);box-shadow:0 8rpx 18rpx rgba(58,62,44,.2)}}

/* Feedback is a first-class form, not a generic settings row. */
.feedback-types{display:flex;flex-wrap:wrap;justify-content:space-between;gap:15rpx;margin:34rpx 0 8rpx}
.feedback-type{flex:0 0 48.5%;width:48.5%;min-height:116rpx;padding:20rpx 17rpx;display:flex;align-items:center;gap:12rpx;text-align:left;color:var(--ink);background:var(--surface);border:1rpx solid var(--border);border-radius:22rpx}
.feedback-type.selected{border:2rpx solid var(--primary);background:var(--soft);box-shadow:0 8rpx 18rpx rgba(39,48,31,.045)}
.feedback-type>text{flex:0 0 38rpx;font-size:36rpx;text-align:center;color:var(--primary)}
.feedback-type>view{font-size:27rpx;font-weight:700;white-space:nowrap}
.feedback-type>view text{display:block;font-size:21rpx;color:var(--muted);font-weight:400;margin-top:9rpx}
.feedback-textarea{width:100%;min-height:230rpx;box-sizing:border-box;padding:25rpx;background:var(--surface);border:1rpx solid var(--border);border-radius:22rpx;font-size:28rpx;line-height:1.65;color:var(--ink)}
.feedback-submit{margin:15rpx 0 50rpx}
.feedback-success{margin-top:55rpx;padding:42rpx 30rpx;background:var(--surface);border:1rpx solid var(--border);border-radius:29rpx;text-align:center}
.feedback-success-icon{width:90rpx;height:90rpx;border-radius:50%;background:var(--soft);color:var(--primary);font-size:51rpx;line-height:90rpx;margin:0 auto 30rpx}
.feedback-success .body-copy{margin:18rpx 0 35rpx}
.feedback-success .secondary{margin-top:15rpx}
.feedback-filter{display:flex;gap:9rpx;margin:30rpx 0 26rpx}
.feedback-filter .pill{flex:1;min-width:0;padding:17rpx 4rpx;font-size:23rpx}
.feedback-inbox-card{background:var(--surface);border:1rpx solid var(--border);border-radius:23rpx;padding:26rpx;margin:0 0 18rpx}
.feedback-inbox-head{display:flex;justify-content:space-between;gap:16rpx;color:var(--primary);font-size:23rpx;font-weight:700}
.feedback-inbox-head text:last-child{color:var(--muted);font-size:20rpx;font-weight:400}
.feedback-inbox-content{font-size:28rpx;line-height:1.7;white-space:pre-wrap;word-break:break-all;margin:20rpx 0}
.feedback-inbox-contact{font-size:23rpx;color:var(--muted)}
.feedback-inbox-actions{display:flex;align-items:center;gap:13rpx;padding-top:18rpx;margin-top:21rpx;border-top:1rpx solid var(--border)}
.feedback-inbox-actions>text{font-size:22rpx;color:var(--muted);margin-right:auto}
.feedback-inbox-actions button{font-size:22rpx;color:var(--primary);padding:10rpx 13rpx;border-radius:12rpx;background:var(--soft)}

/* Night colours use the same surface hierarchy and keep controls legible. */
.app.night .tabbar .tab-icon{opacity:.76}
.app.night .tabbar .tab-item.current .tab-icon{opacity:1}
.app.night .form-error,.app.night .text-danger{color:#F0A994}
.app.night .weather-stage.weather-rain .weather-stage-copy,.app.night .weather-stage.weather-snow .weather-stage-copy{color:#17251F}
.app.night .weather-stage.weather-rain .weather-stage-copy text:last-child,.app.night .weather-stage.weather-snow .weather-stage-copy text:last-child{opacity:1}
.app.night .weather-snow .weather-sky .weather-glyph,.app.night .weather-rain .weather-sky .weather-glyph{color:#243F4B}

/* Theme safety: WeChat buttons have a default black foreground, so they must
   inherit the active theme before individual components refine their colour. */
.app button{color:inherit}.app button::after{border:0}.app.night .plant-card,.app.night .shortcut-row button,.app.night .garden-card,.app.night .context-card,.app.night .weather-card,.app.night .outline-add{color:var(--ink)}.app.night .plant-name,.app.night .garden-name,.app.night .section-title,.app.night .page-heading,.app.night .card-title{color:var(--ink)}.app.night .plant-tag,.app.night .body-copy,.app.night .garden-card-footer,.app.night .progress-label,.app.night .context-label{color:var(--muted)}

.home-context {
  display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:16rpx; margin-top:20rpx;
}
.home .home-topline { margin-bottom:16rpx; }
.home .hero-label { gap:12rpx; color:var(--muted); font-size:23rpx; }
.home .season-stamp { margin:0; padding:4rpx 11rpx; letter-spacing:0; color:var(--primary); }
.app .home .theme-entry { min-height:66rpx; color:var(--ink); padding:10rpx 0 10rpx 24rpx; }
.home .hero {
  min-height:0; margin:0; padding:30rpx 28rpx; border-radius:24rpx;
  background:linear-gradient(135deg,var(--hero),var(--surface)); box-shadow:none;
}
.home .hero-title { margin:0; font-size:44rpx; line-height:1.3; }
.home .hero-copy { max-width:460rpx; margin:12rpx 0 20rpx; color:var(--ink); font-size:25rpx; }
.home .hero-fields { opacity:.32; }
.app .home .hero-cta {
  min-width:0; min-height:72rpx; gap:16rpx; margin:0; padding:12rpx 24rpx;
  background:#3F614C; color:#FFFFFF; font-size:26rpx; line-height:1.2;
  box-shadow:none; animation:none;
}
.app .home .hero-cta text { margin:0; color:inherit; }
.home .section-head { margin:32rpx 0 14rpx; align-items:center; }
.home .section-title { font-size:35rpx; }
.app .home-more { color:var(--primary); min-height:64rpx; }
.home-plant-list { overflow:hidden; border:1rpx solid var(--border); border-radius:20rpx; background:var(--surface); }
.app .home-plant-row {
  display:flex; align-items:center; text-align:left; gap:16rpx; width:100%; min-height:96rpx;
  padding:14rpx 22rpx; color:var(--ink);
}
.home-plant-row + .home-plant-row { border-top:1rpx solid var(--border); }
.home-plant-name { flex:1; min-width:0; font-size:30rpx; font-weight:650; }
.home-plant-category { color:var(--muted); font-size:24rpx; }
.home-plant-arrow { color:var(--primary); font-size:34rpx; line-height:1; }
.app .primary { color:var(--on-primary); }
.app .home-context .context-card {
  display:block; grid-column:auto; min-height:110rpx; margin:0; padding:16rpx 20rpx;
}
.app .home-context-single .context-card { grid-column:1/-1; }
.home-context .context-card .context-label { margin-bottom:6rpx; }
.home-context .context-card > view { max-width:none; font-size:25rpx; }
.garden-environment-options {
  display:grid;
  grid-template-columns:repeat(4,minmax(0,1fr));
  gap:10rpx;
}
.garden-environment-filters {
  grid-template-columns:repeat(5,minmax(0,1fr));
  margin:22rpx 0 20rpx;
}
.app .garden-environment-option {
  display:flex;
  justify-content:center;
  align-items:center;
  width:100%;
  min-height:76rpx;
  padding:8rpx 5rpx;
  border:1rpx solid var(--border);
  border-radius:16rpx;
  background:var(--surface);
  color:var(--ink);
  font-size:24rpx;
  line-height:1.3;
}
.app .garden-environment-option.selected {
  border-color:var(--primary);
  background:var(--primary);
  color:var(--on-primary);
  font-weight:650;
}
.app .garden-environment-edit {
  padding:21rpx 0;
  border-bottom:1rpx solid var(--border);
}
.garden-plant-meta {
  margin-top:6rpx;
  color:var(--muted);
  font-size:25rpx;
  line-height:1.45;
}
.plant-photo-actions { display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:12rpx; }
.app .photo-correction-link { min-height:68rpx; padding:0 8rpx; color:var(--muted); font-size:25rpx; line-height:68rpx; }
.photo-correction-form .body-copy { margin-bottom:18rpx; }
.photo-encoding-canvas { position:fixed; left:-1200px; top:0; width:640px; height:640px; pointer-events:none; }
.app .photo-correction-picker {
  display:flex; width:100%; align-items:center; justify-content:center; gap:20rpx;
  min-height:82rpx; padding:14rpx; margin-bottom:18rpx; border:1rpx dashed var(--border);
  border-radius:20rpx; background:var(--soft); color:var(--ink); font-size:27rpx;
}
.photo-correction-picker image { width:150rpx; height:150rpx; flex:0 0 150rpx; }
.app .photo-authorization {
  display:flex; align-items:center; gap:12rpx; min-height:78rpx; text-align:left;
  font-size:24rpx; line-height:1.4; color:var(--ink); padding:8rpx 0;
}
.photo-authorization-mark {
  display:flex; align-items:center; justify-content:center; flex:0 0 35rpx; height:35rpx;
  box-sizing:border-box; border:1rpx solid var(--primary); border-radius:10rpx; font-size:25rpx;
}
.photo-authorization-mark.checked { background:var(--primary); color:var(--on-primary); }
.app .correction-inbox-entry { width:100%; margin-bottom:20rpx; }
.todo-overview {
  padding:30rpx 28rpx 26rpx;
  border:1rpx solid var(--border);
  border-radius:28rpx;
  background:var(--soft);
  color:var(--ink);
}
.todo-overview-top,.todo-progress-line {
  display:flex;
  justify-content:space-between;
  align-items:baseline;
  gap:10rpx 16rpx;
  flex-wrap:wrap;
}
.todo-overview-title { font-size:32rpx; font-weight:700; }
.todo-date,.todo-progress-total,.todo-progress-status {
  font-size:25rpx;
  color:var(--muted);
}
.todo-date { font-variant-numeric:tabular-nums; }
.todo-progress-line { margin-top:14rpx; }
.todo-progress-count { font-size:58rpx; line-height:1; font-weight:750; }
.todo-progress-track {
  height:12rpx;
  margin:16rpx 0 18rpx;
  border-radius:20rpx;
  overflow:hidden;
  background:var(--border);
}
.todo-progress-fill {
  height:100%;
  border-radius:inherit;
  background:var(--primary);
  transition:width .24s ease-out;
}
.todo-overview-copy { color:var(--muted); font-size:26rpx; line-height:1.6; }
.todo-group { margin-top:30rpx; }
.todo-group-title {
  display:flex;
  align-items:center;
  gap:14rpx;
  margin-bottom:14rpx;
  font-size:30rpx;
  font-weight:700;
  color:var(--ink);
}
.todo-group-title text {
  min-width:32rpx;
  padding:3rpx 10rpx;
  border-radius:20rpx;
  background:var(--soft);
  color:var(--ink);
