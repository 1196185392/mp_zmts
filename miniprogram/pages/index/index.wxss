  text-align:center;
}
.todo-list {
  overflow:hidden;
  border:1rpx solid var(--border);
  border-radius:24rpx;
  background:var(--surface);
}
.todo-row { display:flex; align-items:center; padding:0 18rpx 0 2rpx; gap:12rpx; }
.todo-row + .todo-row { border-top:1rpx solid var(--border); }
.app .todo-toggle {
  display:flex;
  flex:1;
  align-items:center;
  gap:17rpx;
  min-width:0;
  min-height:112rpx;
  padding:18rpx 4rpx 18rpx 18rpx;
  text-align:left;
}
.todo-checkmark {
  display:flex;
  align-items:center;
  justify-content:center;
  box-sizing:border-box;
  flex:0 0 43rpx;
  height:43rpx;
  border:2rpx solid var(--primary);
  border-radius:50%;
  font-size:27rpx;
  line-height:1;
}
.todo-done .todo-checkmark { background:var(--primary); color:var(--on-primary); }
.todo-task-copy { min-width:0; }
.todo-task-name { color:var(--ink); font-size:30rpx; line-height:1.3; font-weight:650; overflow-wrap:break-word; }
.todo-task-place { margin-top:6rpx; color:var(--muted); font-size:24rpx; line-height:1.35; }
.app .todo-record {
  flex:0 0 auto;
  min-height:68rpx;
  padding:0 18rpx;
  border:1rpx solid var(--border);
  border-radius:20rpx;
  background:var(--soft);
  color:var(--ink);
  font-size:24rpx;
  line-height:66rpx;
}
.todo-empty {
  margin-top:18rpx;
  padding:52rpx 28rpx;
  border:1rpx solid var(--border);
  border-radius:28rpx;
  background:var(--surface);
  text-align:center;
}
.todo-empty-art {
  display:flex;
  justify-content:center;
  align-items:center;
  width:92rpx;
  height:92rpx;
  margin:0 auto 24rpx;
  border-radius:28rpx;
  background:var(--soft);
}
.todo-empty-art image { width:48rpx; height:48rpx; }
.todo-empty-title { margin-bottom:10rpx; color:var(--ink); font-size:34rpx; font-weight:700; }
.app .todo-empty button { margin:24rpx auto 0; }
@media (prefers-reduced-motion: reduce) {
  .todo-progress-fill { transition:none; }
}
.app button.library-banner { width: 100%; text-align: left; }
.catalog-filters, .planting-city-grid {
  display:grid; grid-template-columns:repeat(3,minmax(0,1fr));
  grid-column-gap:16rpx; grid-row-gap:14rpx; margin-top:22rpx;
}
.app .catalog-filter {
  display:flex; align-items:center; justify-content:center; min-height:86rpx;
  width:100%; padding:10rpx; border:1rpx solid var(--border); border-radius:17rpx;
  background:var(--surface); color:var(--ink); font-size:26rpx;
}
.app .catalog-filter.active {
  background:var(--primary); border-color:var(--primary); color:var(--on-primary); font-weight:650;
}
.app .clear-planting-city {
  display:block; min-height:86rpx; margin:20rpx auto 0; padding:14rpx 22rpx;
  color:var(--muted); font-size:25rpx;
}
.app .catalog-grid {
  display:grid; grid-template-columns:repeat(2,minmax(0,1fr));
  grid-row-gap:18rpx; grid-column-gap:18rpx; align-items:start;
}
.app .catalog-grid .catalog-card {
  display:block; width:100%; max-width:none; margin:0; padding:0;
  border:1rpx solid var(--border); border-radius:20rpx;
  background:var(--surface); color:var(--ink);
}
.catalog-photo { width:100%; height:312rpx; background:var(--soft); display:block; }
.catalog-card-copy { padding:17rpx 19rpx 20rpx; }
.catalog-card .catalog-card-bottom { gap:8rpx; align-items:baseline; margin:0 0 6rpx; padding:0; }
.catalog-card-copy .plant-tag { color:var(--muted); font-size:23rpx; }
.app .plant-detail-photo-button {
  position:relative; display:block; width:100%; margin-bottom:20rpx;
  overflow:hidden; border-radius:22rpx; background:var(--soft);
}
.plant-detail-photo { display:block; width:100%; height:650rpx; max-height:56vh; }
.plant-detail-zoom-label {
  position:absolute; right:16rpx; bottom:16rpx; padding:7rpx 17rpx; border-radius:22rpx;
  background:var(--surface); color:var(--ink); font-size:24rpx; line-height:1.4;
}
.catalog-zoom-layer {
  position:fixed; inset:0; z-index:85; box-sizing:border-box; display:flex; flex-direction:column;
  padding:calc(28rpx + env(safe-area-inset-top)) 20rpx calc(24rpx + env(safe-area-inset-bottom));
  background:var(--bg); color:var(--ink);
}
.catalog-zoom-header {
  display:flex; align-items:center; justify-content:space-between; gap:20rpx;
  min-height:93rpx; padding:0 12rpx; font-size:33rpx; font-weight:700;
}
.app .catalog-zoom-header button {
  flex:0 0 76rpx; height:76rpx; line-height:76rpx; border-radius:24rpx;
  background:var(--surface); color:var(--ink); font-size:42rpx;
}
.catalog-zoom-stage { display:block; flex:1; min-height:0; width:100%; height:70vh; overflow:hidden; }
.catalog-zoom-movable,.catalog-zoom-photo { display:block; width:100%; height:100%; }
.catalog-zoom-help { text-align:center; padding:16rpx 0 4rpx; color:var(--muted); font-size:25rpx; }
.catalog-zoom-unavailable { flex:1; display:flex; align-items:center; justify-content:center; color:var(--muted); }
.plant-scientific-name { color:var(--muted); font-size:25rpx; line-height:1.5; }
.plant-scientific-name text { margin-left:8rpx; font-style:italic; }
.about-page { padding-bottom:42rpx; }
.about-intro {
  display:flex; flex-direction:column; align-items:center; gap:17rpx;
  padding:46rpx 42rpx 38rpx; text-align:center; background:var(--hero);
  border:1rpx solid var(--border); border-radius:28rpx;
}
.about-mark {
  display:flex; align-items:center; justify-content:center; width:94rpx; height:94rpx;
  border-radius:25rpx; background:var(--primary); color:var(--on-primary); font-size:46rpx;
}
.about-name { color:var(--ink); font-size:45rpx; font-weight:700; }
.about-description { color:var(--muted); font-size:26rpx; line-height:1.65; }
.about-details {
  margin-top:23rpx; padding:4rpx 26rpx; background:var(--surface);
  border:1rpx solid var(--border); border-radius:24rpx;
}
.about-detail { padding:24rpx 0; }
.about-detail + .about-detail { border-top:1rpx solid var(--border); }
.about-detail .body-copy { display:block; margin-top:8rpx; }
.app .action-footer .theme-save {
  background:#3F614C; color:#FFFFFF; font-weight:700;
}
.planting-region-copy { display:block; margin-bottom:22rpx; }
.app .planting-location-action { margin-top:16rpx; }
.app .sheet {
  margin:0; border:1rpx solid var(--border); border-bottom:0; color:var(--ink);
  max-height:86vh;
}
.app .sheet-title { gap:20rpx; margin-bottom:24rpx; font-weight:700; }
.app .sheet-title button {
  width:64rpx; height:64rpx; flex:none; display:flex; align-items:center; justify-content:center;
  border-radius:50%; color:var(--ink); background:var(--soft);
}
.sheet-actions { display:flex; gap:16rpx; margin-top:28rpx; }
.app .sheet-actions button { flex:1; min-width:0; }
.app .sheet-actions .danger { background:#933B31; color:#FFFFFF; }
.region-columns { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:10rpx; }
.region-column { min-width:0; border:1rpx solid var(--border); border-radius:18rpx; overflow:hidden; background:var(--bg); }
.region-column-title { display:block; padding:16rpx 12rpx; background:var(--soft); text-align:center; color:var(--ink); font-size:24rpx; font-weight:650; }
.region-scroll { height:32vh; min-height:180rpx; max-height:520rpx; }
.app .region-option {
  display:flex; justify-content:center; align-items:center; width:100%; min-height:80rpx;
  padding:10rpx 12rpx; font-size:24rpx; line-height:1.35; color:var(--ink);
}
.app .region-option.selected { background:var(--primary); color:var(--on-primary); font-weight:700; }
.region-empty { padding:22rpx 6rpx; text-align:center; color:var(--muted); font-size:22rpx; }
.app .sheet .sheet-disabled { background:var(--soft)!important; color:var(--muted)!important; box-shadow:none; opacity:1; }
.photo-viewer { height:56vh; background:var(--bg); border-radius:18rpx; overflow:hidden; }
.viewer-photo { width:100%; height:100%; }
.photo-viewer-count { text-align:center; color:var(--muted); padding-top:16rpx; font-size:24rpx; }
.app-toast {
  position:fixed; left:50%; bottom:calc(152rpx + env(safe-area-inset-bottom)); z-index:90;
  transform:translateX(-50%); width:max-content; max-width:82%; padding:18rpx 28rpx;
  border-radius:18rpx; background:var(--primary); color:var(--on-primary); font-size:26rpx;
  line-height:1.45; text-align:center; pointer-events:none;
}
.detail-hero.text-only {
  height:auto; background:transparent; margin-bottom:16rpx;
}
.detail-hero.text-only > .badge { position:static; }
.glossary-entry .body-copy { margin-top:8rpx; color:var(--ink); }
.hero-weather { position:absolute; inset:0; pointer-events:none; overflow:hidden; border-radius:inherit; }
.hero-weather-rain { background:linear-gradient(155deg,transparent 38%,rgba(66,129,164,.18)); }
.hero-weather-snow { background:linear-gradient(155deg,transparent 38%,rgba(214,234,250,.28)); }
.hero-sun {
  position:absolute; width:240rpx; height:240rpx; right:-30rpx; top:-70rpx; border-radius:50%;
  background:radial-gradient(circle,rgba(255,215,117,.78),rgba(255,205,90,.28) 50%,transparent 72%);
  animation:hero-sunlight 5s ease-in-out infinite alternate;
}
.hero-weather-particle {
  position:absolute; top:-34rpx; left:62%; width:4rpx; height:26rpx;
  background:#78a9cf; border-radius:10rpx; opacity:0;
  animation:hero-rain 1.55s linear infinite;
}
.night .hero-weather-particle { background:#a8cee7; }
.hero-weather-snow .hero-weather-particle {
  width:11rpx; height:11rpx; background:#f7fcff; box-shadow:0 0 0 1rpx rgba(92,136,161,.32);
  animation-name:hero-snow; animation-duration:6s;
}
.hero-weather-particle:nth-child(2n) { left:81%; animation-delay:-.4s; }
.hero-weather-particle:nth-child(3n) { left:92%; animation-delay:-1.2s; }
.hero-weather-particle:nth-child(4n) { left:53%; animation-delay:-.95s; }
.hero-weather-particle:nth-child(5n) { left:73%; animation-delay:-.3s; }
.hero-weather-particle:nth-child(7n) { left:97%; animation-delay:-1.4s; }
.hero-weather-particle:nth-child(9n) { left:67%; animation-delay:-.7s; }
.hero-weather-snow .hero-weather-particle:nth-child(2n) { animation-duration:5s; animation-delay:-2.6s; }
.hero-weather-snow .hero-weather-particle:nth-child(3n) { animation-duration:7s; animation-delay:-4s; }
.hero-weather-snow .hero-weather-particle:nth-child(5n) { animation-delay:-3s; }
@keyframes hero-rain {
  0% { transform:translate(42rpx,-5rpx) rotate(20deg); opacity:0; }
  18%,80% { opacity:.82; }
  100% { transform:translate(-110rpx,520rpx) rotate(20deg); opacity:0; }
}
@keyframes hero-snow {
  0% { transform:translate(0,-10rpx); opacity:0; }
  18%,82% { opacity:.95; }
  45% { transform:translate(-28rpx,226rpx); }
  100% { transform:translate(12rpx,510rpx); opacity:0; }
}
@keyframes hero-sunlight {
  from { transform:scale(.9); opacity:.62; }
  to { transform:scale(1.22); opacity:1; }
}
@media (prefers-reduced-motion: reduce) {
  .hero-sun,.hero-weather-particle { animation:none; }
}

/* Garden filters are real touch targets rather than tightly packed text tabs. */
.garden-tabs{display:flex;gap:16rpx;white-space:normal;overflow:visible;border-bottom:0;margin:28rpx 0 30rpx}.garden-tabs .tab{margin:0;min-width:132rpx;min-height:76rpx;padding:0 27rpx;display:flex;align-items:center;justify-content:center;border:1rpx solid var(--border);border-radius:40rpx;background:var(--surface);color:var(--muted);font-size:26rpx;line-height:1}.garden-tabs .tab.active{background:var(--primary);border-color:var(--primary);color:var(--on-primary);box-shadow:0 7rpx 17rpx rgba(33,45,33,.12)}

/* The bottom navigation keeps only the daily actions; learning lives in 我的. */
.simple-tabbar{position:relative;padding-left:12rpx;padding-right:12rpx}.app .simple-tabbar .tab-item{flex:0 0 25%;width:25%}.app .simple-tabbar .tab-item:last-child{margin-left:25%}.app .simple-tabbar .tab-add{position:absolute;left:50%;top:6rpx;transform:translateX(-50%) translateY(-12rpx);z-index:3;flex:0 0 102rpx;width:102rpx;min-width:102rpx;padding:0}.simple-tabbar .tab-add-mark{width:68rpx;height:68rpx;border-radius:24rpx}.simple-tabbar .tab-add .tab-label{margin-top:2rpx;font-size:21rpx}.simple-tabbar .tab-item{min-height:110rpx}.simple-tabbar .tab-label{font-size:23rpx}

/* One-time welcome tour, replayable from 我的. */
.guide-mask{position:fixed;z-index:80;inset:0;background:rgba(8,17,13,.66);display:flex;align-items:flex-end;padding:0 27rpx calc(32rpx + env(safe-area-inset-bottom));box-sizing:border-box}.guide-card{width:100%;box-sizing:border-box;background:#f8f8f1;color:#1d2b22;border:1rpx solid rgba(221,232,205,.95);border-radius:34rpx;padding:34rpx 30rpx 28rpx;box-shadow:0 -16rpx 52rpx rgba(0,0,0,.28);animation:guide-rise .35s cubic-bezier(.2,.9,.25,1) both}.guide-count{font-size:20rpx;color:#647160;text-align:right}.guide-eyebrow{display:block;font-size:20rpx;color:#59753a;font-weight:700;letter-spacing:2rpx;margin:3rpx 0 15rpx}.guide-title{font-size:38rpx;line-height:1.42;font-weight:700;color:#1d2b22}.guide-copy{font-size:26rpx;line-height:1.75;color:#526055;margin:19rpx 0 29rpx}.guide-actions{display:flex;gap:16rpx;align-items:center}.guide-actions button{min-height:84rpx;border-radius:23rpx;font-size:27rpx;font-weight:700}.guide-skip{flex:0 0 145rpx;background:#e7eee1;color:#40553a}.guide-next{flex:1;background:#6d8d4a;color:#fff}.guide-next text{font-size:31rpx;margin-left:10rpx}@keyframes guide-rise{from{opacity:0;transform:translateY(50rpx)}to{opacity:1;transform:translateY(0)}}

.app .guide-card { background:var(--surface); border-color:var(--border); color:var(--ink); }
.app .guide-title,.app .guide-copy { color:var(--ink); }
.app .guide-count { color:var(--muted); }
.app .guide-eyebrow { color:var(--primary); }
.app .guide-actions button {
  display:flex; align-items:center; justify-content:center; height:88rpx; gap:9rpx;
  margin:0; padding:0 14rpx; line-height:1; text-align:center;
}
.app .guide-actions .guide-skip { background:var(--soft); color:var(--ink); }
.app .guide-actions .guide-next { background:var(--primary); color:var(--on-primary); }
.app .guide-actions .guide-next text { margin:0; line-height:1; }
/* Five durable destinations, with recording kept as the centre action. */
.five-tabbar{position:relative;padding-left:10rpx;padding-right:10rpx}.app .five-tabbar .tab-item,.app .five-tabbar .tab-add{flex:1 1 20%;width:20%;min-width:0}.five-tabbar .tab-add{transform:translateY(-6rpx)}.five-tabbar .tab-add-mark{width:62rpx;height:62rpx;border-radius:21rpx}.five-tabbar .tab-add .tab-label{margin-top:2rpx;font-size:20rpx}.five-tabbar .tab-item{min-height:108rpx}.five-tabbar .tab-label{font-size:21rpx}
