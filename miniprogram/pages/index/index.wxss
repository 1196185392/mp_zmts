/* Reset native v2 button intrinsic widths inside responsive layouts. */
.app button{min-width:0;box-sizing:border-box;margin-left:0;margin-right:0}
.plant-grid{display:flex;flex-direction:row;flex-wrap:wrap;justify-content:space-between;width:100%}
.plant-grid .plant-card{flex:0 0 48.3%;width:48.3%;max-width:48.3%;min-width:0;margin-left:0;margin-right:0}
.tabbar .tab-item{flex:1;width:0;min-width:0;padding:0}
.tabbar .tab-plus{flex:0 0 84rpx;width:84rpx;max-width:84rpx;min-width:0;padding:0;margin-left:20rpx;margin-right:20rpx}

